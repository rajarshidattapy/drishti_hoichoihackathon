OPENAI_API_KEY=
SARVAM_API_KEY=
HF_TOKEN=
DATA_DIR=../data
DATABASE_URL=
REDIS_URL=redis://localhost:6379
LLM_MODEL_DEFAULT=gpt-4.1-mini
LLM_MODEL_SCENES=gpt-4.1-mini
# The runner stops before any LLM call that would push the episode past this budget.
MAX_LLM_USD_PER_EPISODE=5
LLM_VISION_CONCURRENCY=8
LLM_TEXT_CONCURRENCY=16
DEVICE=cpu
WORKER_CONCURRENCY=1
# Stages whose inputs are ready run in parallel (the audio and video branches are independent until s10).
STAGE_PARALLELISM=2
# dhash (no model download) or siglip (needs the gpu extra; downloads google/siglip-base-patch16-224).
FRAME_EMBEDDER=dhash
SEED_DEMO=true
# Comma-separated browser origins permitted to call the API. Set this to your Vercel
# frontend URL(s), for example: https://drishti.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
